# Waitlist → Google Sheets backend. Copy to .env.local and fill in.
# Full setup walkthrough: SETUP_SHEETS.md
#
# Until all three required vars are set, /api/waitlist logs signups to the
# server console and returns success without saving anything.

# Service account email from the downloaded JSON key (client_email).
GOOGLE_SHEETS_CLIENT_EMAIL=

# Service account private key from the JSON (private_key). Wrap in double
# quotes and keep the literal \n sequences — they're converted to newlines.
GOOGLE_SHEETS_PRIVATE_KEY=

# The target Sheet's ID, from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
WAITLIST_SHEET_ID=

# Optional. Defaults to Sheet1!A:F. Set only if your tab isn't named "Sheet1".
# WAITLIST_SHEET_RANGE=Sheet1!A:F
